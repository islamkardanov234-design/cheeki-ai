# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI-провайдеры ===
# Достаточно задать ключ хотя бы для ОДНОГО провайдера.
# Роутер автоматически использует доступные модели и делает fallback.

# OpenAI (GPT) — используется по умолчанию
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Gemini (Google)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Kimi (Moonshot) — OpenAI-совместимый API
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=moonshot-v1-8k

# DeepSeek — OpenAI-совместимый API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# === Настройки роутера (необязательно) ===
# Модель по умолчанию, если авто-роутинг ничего конкретного не выбрал
ROUTER_DEFAULT_MODEL=gpt-4o-mini
# Порядок fallback через запятую (если у выбранной модели нет ключа)
ROUTER_FALLBACK_ORDER=gpt-4o-mini,claude,gemini,kimi,deepseek,gpt-4o
